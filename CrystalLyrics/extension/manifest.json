{
  "manifest_version": 3,
  "name": "CrystalLyrics • Synced YouTube Lyrics",
  "version": "1.4.0",
  "minimum_chrome_version": "116",
  "description": "Synced YouTube lyrics with optional word effects, cover/video colors, audio timing, glow, fonts and movable transparent boxes.",
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen"],
  "host_permissions": ["https://lrclib.net/*", "https://huggingface.co/*", "https://*.hf.co/*", "https://*.huggingface.co/*", "https://itunes.apple.com/*", "https://*.mzstatic.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["vendor/js-yaml.min.js", "lyrics-core.js", "word-timing.js", "effects.js", "appearance.js", "palette-core.js", "color-matching.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{"resources": ["fonts/*.ttf"], "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"]}],
  "action": {
    "default_title": "CrystalLyrics",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self' https://lrclib.net https://huggingface.co https://*.hf.co https://*.huggingface.co https://itunes.apple.com https://*.mzstatic.com; worker-src 'self'"
  }
}
